target
# Track the workspace lockfile (reproducible binary/CI builds); keep the
# nested crates' lockfiles (nodejs, vtracer-py, webapp) ignored.
Cargo.lock
!/Cargo.lock
*.sublime*
.vscode
.DS_Store

# PixPath lab output
lab/out/

# PixPath app build output
app/wasm/target/
app/web/pkg/

# Test images: may include third-party logos/artwork; never publish
lab/samples/
lab/results/
app/desktop/node_modules/
app/desktop/src-tauri/target/
app/desktop/src-tauri/gen/
# Apps ship: pin their dependency versions
!app/desktop/src-tauri/Cargo.lock
!app/wasm/Cargo.lock
